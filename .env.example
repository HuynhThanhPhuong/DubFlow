# Set these environment variables in PowerShell before running scripts/start.ps1.
DUBFLOW_DATA_DIR=D:/DuAnKhoiNghiep/DubFlow/data
DUBFLOW_FFMPEG=D:/OmniVoice/tools/ffmpeg.exe
DUBFLOW_FFPROBE=D:/OmniVoice/tools/ffprobe.exe
DUBFLOW_ASR_PYTHON=D:/OmniVoice/venv/Scripts/python.exe
DUBFLOW_TTS_PYTHON=D:/DuAnKhoiNghiep/DubFlow/repo-tests/clone-voxcpm/Scripts/python.exe
DUBFLOW_OCR_PYTHON=D:/DuAnKhoiNghiep/DubFlow/repo-tests/ocr/Scripts/python.exe
DUBFLOW_MODEL_CACHE=D:/DuAnKhoiNghiep/DubFlow/repo-tests/runtime/hf-cache
DUBFLOW_ASR_CACHE=D:/OmniVoice/cache/hf
DUBFLOW_TRANSLATION_MODE=manual
# For a cached local translation model: mode=local and point at a real model directory.
DUBFLOW_TRANSLATION_MODEL=
# API translation is text-only, activated explicitly with mode=api.
DUBFLOW_TRANSLATION_API_URL=
DUBFLOW_TRANSLATION_API_MODEL=
DUBFLOW_TRANSLATION_API_KEY=
# Leave empty for durable local SQLite queue. RQ requires a separate worker.
DUBFLOW_REDIS_URL=
